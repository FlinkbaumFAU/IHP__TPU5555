C {vsource.sym} -1160 60 1 0 {name=V6 value="PWL(0 0 \{T_RESET\} 0 \{T_RESET + CT\} \{VDD\})" savecurrent=false}
C {lab_pin.sym} -1110 60 2 0 {name=p12 sig_type=std_logic lab=Resetb
value="PWL(0 \{VDD\} \{T_FREQ + CT\}"}
C {lab_pin.sym} -1210 60 0 0 {name=p13 sig_type=std_logic lab=VSS
value="PWL(0 \{VDD\} \{T_FREQ + CT\}"}
C {code_shown.sym} -1590 -590 0 0 {name=LIB only_toplevel=false value="tcleval(
* This block is tcleval()'d: xschem runs it through tcl subst when writing the
* netlist. A stray dollar sign or open bracket is therefore a tcl error, and a
* failed tcleval turns the WHOLE block into a single question mark, silently.
* clk_gen/Makefile greps the netlist for it. See CLAUDE.md.

* dco_decode.spice is generated by simulations/gen_decode_spice.py, not drawn,
* so the Netlist button rebuilds it here. rc=0 is success; otherwise read
* clk_gen/build/mk_dco_decode.log and expect a stale model below.
* mk dco_decode.spice rc=[file mkdir $env(MSDB_ROOT)/clk_gen/build][catch \{exec make -s -C $env(MSDB_ROOT)/clk_gen simulations/dco_decode.spice >& $env(MSDB_ROOT)/clk_gen/build/mk_dco_decode.log\}]

.LIB cornerMOSlv.lib mos_tt
.OPTIONS KLU
.INCLUDE sg13g2_stdcell.spice
.INCLUDE custom_stdcell.spice

* Absolute, from MSDB_ROOT (exported by tools/xschem): make runs ngspice from
* clk_gen/, the Simulate button from netlist_dir (the repo root), so a relative
* include only works for one of them.
.INCLUDE $env(MSDB_ROOT)/clk_gen/simulations/dco_decode.spice

* Same for the raw file, handed to the CODE block as an ngspice variable.
* setcs, not set: set lower-cases its value.
.control
  setcs rawfile = $env(MSDB_ROOT)/clk_gen/simulations/test_clk_gen.raw
.endc
.PARAM VDD=1.2
.PARAM T_REF=10n
.PARAM CT=50p
.PARAM TEMP=28
.PARAM T_RESET=\{T_REF + 0.1n\}
)"
place=header}
C {code_shown.sym} -90 -390 0 0 {name=CODE only_toplevel=false value="
VVDD VDD 0 DC \{VDD\}
VVSS VSS 0 0
.control
  save all
  tran 10p 30n
  write $rawfile
  quit
.endc
"}
