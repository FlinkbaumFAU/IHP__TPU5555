C {lab_pin.sym} -680 140 2 0 {name=p1 sig_type=std_logic lab=C[1]}
C {gnd.sym} -660 20 0 0 {name=l1 lab=VSS}
C {vdd.sym} -700 40 0 0 {name=l2 lab=VDD}
C {lab_pin.sym} -680 80 2 0 {name=p4 sig_type=std_logic lab=C[0]}
C {vsource.sym} -1030 100 1 0 {name=V3 value="PULSE(0 \{VDD\} 0 \{CT\} \{CT\} \{T_REF/2\} \{T_REF\}" savecurrent=false}
C {lab_pin.sym} -980 100 2 0 {name=p6 sig_type=std_logic lab=clk_ref}
C {lab_pin.sym} -1080 100 0 0 {name=p7 sig_type=std_logic lab=VSS}
C {lab_pin.sym} -680 260 2 0 {name=p8 sig_type=std_logic lab=C[3]}
