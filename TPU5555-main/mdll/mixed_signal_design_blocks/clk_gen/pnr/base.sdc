# Timing constraints for clk_gen.
#
# This block is a DCO/MDLL, so it is not a normal synchronous design:
#
#  * delay_cell's cross-coupled inverters (x11/x12) are a latch, and the ring
#    through the four delay cells and the injection mux is a deliberate
#    combinational loop. OpenSTA detects and breaks these automatically and
#    reports them -- that is expected here, not a failure to fix.
#  * clk_out is generated by the ring, not derived from clk_ref by anything the
#    tool can trace, so it is declared as its own clock.
#
# There is no timing target to close: the oscillation period is set by the cap
# bank, characterised in simulations/, not by STA.

create_clock -name clk_ref -period 10.0 [get_ports clk_ref]

# --- the DCO clocks ---------------------------------------------------------
#
# Declared on the drivers of the internal clk_out / clk_outb nets (the ring's
# output inverters x1.x10 and x1.x2), not on the clk_out port. A clock on an
# output port reaches no flop inside the block: the divider and x12 used to be
# timed with clk_ref propagated THROUGH the ring -- injection mux, delay cells
# and their keeper loops -- which STA models about 2x faster than the
# transistor-level ring. Every hold/removal violation of the 2026-10-21 runs
# (x11.x1, x11.x2, x12 RESET_B, -0.61..-0.02 ns) was that artefact. A
# create_clock on a pin stops the clocks arriving from upstream, so these flops
# now see only the DCO clocks.
#
# clk_outb is clk_out inverted, so it gets its own clock half a period later in
# the same group: x12 (clk_outb rising) -> x13/C -> x11.x1/x2 RESET_B (clk_out
# rising) is then the half-period recovery/removal check it physically is.
#
# The period is the fastest DCO period in operation of the corner being timed,
# about 5% under it. Since the inv_2 / cap_8 ring (2026-10-30) that is the
# period at lock_ctrl's START code (8-bit 0x18), not at code 0: acquisition
# starts there, and below it the ring only passes on its way to a rail restart
# (code 0 is 0.92/1.48/0.60 ns; there x12 misses the injection edge anyway,
# which is why START exists -- rtl/lock_ctrl.v). The ring as laid out: each
# ring node carries ~6.3 fF of wiring (Calibre xRC of the 10-29 layout), which
# simulations/dco_variant.py --wire 1 adds to the schematic ring. At START that
# gives 1.33/2.12/0.88 ns at typ/slow/fast (schematic without the wire:
# 1.23/2.01/0.79), so 1.26/2.01/0.83. The wire belongs to the layout this STA
# times, and the inv_2 / cap_8 cells are larger than the ones it was extracted
# from, so the ring nodes do not get shorter. (Before: code 0 of the inv_1 /
# cap_4 ring, 1.28/2.06/0.83 ns, timed at 1.2/1.95/0.78.) One period for all corners
# is wrong either way -- 1.2 ns fails x12 -> x11 recovery at slow (-0.24 ns,
# with cell delays of a corner whose ring is 2.06 ns) and passes it at fast
# where the ring is 0.83 ns. Signoff STA runs one corner per process and sets
# _CURRENT_CORNER_NAME; the multi-corner OpenROAD steps (placement, resizer)
# have none and get the slow period, so they do not chase a corner/period
# mismatch. That x12 -> x11 release is the tightest real check here: ~0.01 ns
# at fast on the 2026-10-21 layout (0.06 typ, 0.13 slow).
set dco_period 2.01
if { [info exists ::env(_CURRENT_CORNER_NAME)] } {
    switch -glob -- $::env(_CURRENT_CORNER_NAME) {
        *typ*  { set dco_period 1.26 }
        *fast* { set dco_period 0.83 }
    }
}
set dco_half [expr { $dco_period / 2.0 }]
create_clock -name dco_clk  -period $dco_period -waveform [list 0.0 $dco_half] \
    [get_pins x1.x10/Y]
create_clock -name dco_clkb -period $dco_period -waveform [list $dco_half $dco_period] \
    [get_pins x1.x2/Y]

# divn1 = g1 & ~g0, period 3 of the divider's Gray count (x11.x4, a nor2b;
# until 2026-10-29 clk2 & clk4 of a binary count) clocks the ICG arm flop
# x11.x6 and the selector
# flop x4.x1. Without a clock there they were unclocked and the ICG enable
# (x11.x6 -> x11.x5/GATE) untimed. From reset the counter's 3rd rising clk_out
# edge raises divn1 and the 4th drops it: master edges 5 and 7, period 4.
create_generated_clock -name divn1 -source [get_pins x11.x1/CLK] -edges {5 7 13} \
    [get_pins x11.x4/Y]

set_clock_uncertainty 0.05 [all_clocks]
set_clock_transition  0.15 [all_clocks]

# The reference and the DCO are asynchronous. They meet only at the injection
# mux, which is intentional and must not be timed as a real path.
set_clock_groups -asynchronous -group {clk_ref} -group {dco_clk dco_clkb divn1}

# OpenSTA has no remove_from_collection (that is a Synopsys collection
# command); -no_clocks is the portable way to exclude the clock port.
set_input_delay 2.0 -clock clk_ref [all_inputs -no_clocks]
set_output_delay 2.0 -clock clk_ref [all_outputs]

# x4.x1 and x11.x6 have D tied high: a clock edge can only raise Q, Q falls
# only through RESET_B. Without this STA times a clocked fall of x4.x1/Q ->
# sel -> selb -> x6 -> x12/RESET_B release (-0.48 ns typ) that cannot happen.
# Their RESET_B -> Q falls stay timed.
set_false_path -from [get_pins {x4.x1/CLK x11.x6/CLK}] -fall_through [get_pins {x4.x1/Q x11.x6/Q}]

# Two exceptions of 2026-10-21 are gone, moot under these clocks (checked in
# OpenSTA on that run's layout: identical results with and without them):
#  * set_false_path -rise_through {x13/A x13/B} (Resetb/selb rising cannot
#    release x11 while x12 holds x13/C low) and
#  * the hold false path clk_ref -> x6/B -> x12/RESET_B (the injection race:
#    one clk_ref edge both releases x12 and, through the ring, clocks it).
# Both are now clk_ref -> DCO-clock paths, which the clock groups leave
# untimed. Neither race is timed by STA: the x12 one is covered by the
# transistor-level check (simulations/gate_check.py --corner {typ,slow,fast}:
# in every period x12/Q rises on the first clk_outb edge after the release,
# which leads it by 222/378/130 ps at START, code 0x18, and more above; below
# START it misses -- see the dco_period comment above), and Resetb is
# asynchronous to the DCO -- x12 is its reset synchroniser.
