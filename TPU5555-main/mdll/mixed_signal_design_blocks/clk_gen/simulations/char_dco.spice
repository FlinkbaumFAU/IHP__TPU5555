** DCO characterisation: oscillation frequency vs. 6-bit thermometer code.
**
** Generated by simulations/gen_char_dco.py -- do not edit by hand.
** The cap bank is 63 identical custom_cap_4 units; enabled-unit count equals
** the code exactly, so the period must rise monotonically with the code.

.LIB /opt/IHP-Open-PDK/ihp-sg13g2/libs.tech/ngspice/models/cornerMOSlv.lib mos_tt
.OPTIONS KLU
.INCLUDE /opt/IHP-Open-PDK/ihp-sg13g2/libs.ref/sg13g2_stdcell/spice/sg13g2_stdcell.spice
.INCLUDE /home/michael/Documents/Passionate/custom_stdcell/custom_stdcell.spice
.PARAM VDD=1.2
.TEMP 27

* ---- delay_cell, mirroring the xschem export of src/delay_cell.sch ----
.subckt delay_cell in out co[7] co[6] co[5] co[4] co[3] co[2] co[1] co[0] cob[7] cob[6] cob[5] cob[4] cob[3] cob[2] cob[1] cob[0] outb inb
x13 out in VDD VSS sg13g2_inv_1
x14 outb inb VDD VSS sg13g2_inv_1
x11 out outb VDD VSS sg13g2_inv_1
x12 outb out VDD VSS sg13g2_inv_1
xco0 co[0] out VDD VSS custom_cap_4
xco1 co[1] out VDD VSS custom_cap_4
xco2 co[2] out VDD VSS custom_cap_4
xco3 co[3] out VDD VSS custom_cap_4
xco4 co[4] out VDD VSS custom_cap_4
xco5 co[5] out VDD VSS custom_cap_4
xco6 co[6] out VDD VSS custom_cap_4
xco7 co[7] out VDD VSS custom_cap_4
xcob0 cob[0] outb VDD VSS custom_cap_4
xcob1 cob[1] outb VDD VSS custom_cap_4
xcob2 cob[2] outb VDD VSS custom_cap_4
xcob3 cob[3] outb VDD VSS custom_cap_4
xcob4 cob[4] outb VDD VSS custom_cap_4
xcob5 cob[5] outb VDD VSS custom_cap_4
xcob6 cob[6] outb VDD VSS custom_cap_4
xcob7 cob[7] outb VDD VSS custom_cap_4
.ends

* ---- ring: 4 delay cells + injection mux ----
x3 net8 net7 t56 t48 t40 t32 t24 t16 t8 t0 t57 t49 t41 t33 t25 t17 t9 t1 net6 net9 delay_cell
x4 net7 net5 t58 t50 t42 t34 t26 t18 t10 t2 t59 t51 t43 t35 t27 t19 t11 t3 net1 net6 delay_cell
x5 net5 net2 t60 t52 t44 t36 t28 t20 t12 t4 t61 t53 t45 t37 t29 t21 t13 t5 net4 net1 delay_cell
x6 net2 ring_p t62 t54 t46 t38 t30 t22 t14 t6 VSS t55 t47 t39 t31 t23 t15 t7 ring_n net4 delay_cell
x7 net8 M_outb VDD VSS sg13g2_inv_2
x8 net9 M_out VDD VSS sg13g2_inv_2
x9 M_outb ring_p clk_ref sel VDD VSS sg13g2_mux2_2
x1 M_out ring_n clk_refb sel VDD VSS sg13g2_mux2_2

xb1 tb1 ring_p VDD VSS sg13g2_inv_1
xb2 tb2 tb1 VDD VSS sg13g2_inv_4
x2 clk_outb tb2 VDD VSS sg13g2_inv_16
xb3 tb3 ring_n VDD VSS sg13g2_inv_1
xb4 tb4 tb3 VDD VSS sg13g2_inv_4
x10 clk_out tb4 VDD VSS sg13g2_inv_16

VVDD VDD 0 DC {VDD}
VVSS VSS 0 0
Vsel sel 0 0          $ free-running: mux selects the ring, not clk_ref
Vref clk_ref 0 0
Vrefb clk_refb 0 {VDD}

* One swept control voltage; each thermometer node derives from it, so
* the loop alters a single source instead of 63.
Vcode code 0 DC 0
Bt0 t0 0 V = (v(code) > 0.5) ? {VDD} : 0
Bt1 t1 0 V = (v(code) > 1.5) ? {VDD} : 0
