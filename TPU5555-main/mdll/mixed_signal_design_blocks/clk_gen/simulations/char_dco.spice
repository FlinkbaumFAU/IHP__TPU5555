.ic v(M_out)=0 v(M_outb)=1.2
.save v(M_out)

.control
set noaskquit
set filetype=ascii
echo code freq > dco_char.csv
let code = 0
while code <= 63
  alter Vcode = code
  tran 20p 220n uic
  meas tran ta when v(M_out)=0.6 rise=5 td=25n
  meas tran tb when v(M_out)=0.6 rise=15 td=25n
  if length(ta) > 0
    let fr = 10/(tb-ta)
    echo "$&code $&fr" >> dco_char.csv
  else
    echo "$&code FAIL" >> dco_char.csv
  end
  destroy all
  let code = code + 1
end
quit
.endc

.GLOBAL VSS
.GLOBAL VDD
.end
