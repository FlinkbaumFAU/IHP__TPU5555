v {xschem version=3.4.7 file_version=1.2}
G {}
K {type=subcircuit
format="@name @pinlist @VDD @VSS @symname"
template="name=x1 VDD=VDD VSS=VSS"
extra="VDD VSS"
}
V {}
S {}
E {}
L 4 -130 -100 130 -100 {}
L 4 130 -100 130 100 {}
L 4 130 100 -130 100 {}
L 4 -130 100 -130 -100 {}
L 4 -150 -60 -130 -60 {}
L 4 -150 -20 -130 -20 {}
L 4 -150 20 -130 20 {}
L 4 -150 60 -130 60 {}
L 4 130 -60 150 -60 {}
L 4 130 -20 150 -20 {}
L 4 130 20 150 20 {}
L 4 130 60 150 60 {}
L 4 130 80 150 80 {}
B 5 -152.5 -62.5 -147.5 -57.5 {name=Clk_out dir=in}
B 5 -152.5 -22.5 -147.5 -17.5 {name=Clk_ref dir=in}
B 5 -152.5 17.5 -147.5 22.5 {name=Sel dir=in}
B 5 -152.5 57.5 -147.5 62.5 {name=Start dir=in}
