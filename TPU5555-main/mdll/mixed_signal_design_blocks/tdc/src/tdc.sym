B 5 147.5 57.5 152.5 62.5 {name=valid dir=out}
B 5 147.5 77.5 152.5 82.5 {name=busy dir=out}
T {Clk_out} -125 -64 0 0 0.2 0.2 {}
T {Clk_ref} -125 -24 0 0 0.2 0.2 {}
T {Sel} -125 16 0 0 0.2 0.2 {}
T {Start (active-low reset)} -125 56 0 0 0.2 0.2 {}
