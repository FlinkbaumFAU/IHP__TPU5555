# xschemrc for batch netlisting (tools/xschem with -q, i.e. every Makefile
# call). Only what netlisting needs: the symbol library path, built from
# PDK_ROOT/PDK, this repo and custom_stdcell next to it. The netlists then do
# not depend on the user's ~/.xschem/xschemrc, which interactive sessions
# still use. Order as in the IHP template rc, custom_stdcell last.

set XSCHEM_LIBRARY_PATH {}
append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library/devices
append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library

if {![info exists env(PDK_ROOT)] || ![file isdir $env(PDK_ROOT)]} {
    puts stderr "tools/xschemrc: PDK_ROOT not set or not a directory"
    exit 1
}
set PDK_ROOT [string trimright $env(PDK_ROOT) /]
set PDK [expr {[info exists env(PDK)] ? $env(PDK) : "ihp-sg13g2"}]
set MODELS_NGSPICE ${PDK_ROOT}/${PDK}/libs.tech/ngspice/models
set SG13G2_MODELS ${PDK_ROOT}/${PDK}/libs.tech/ngspice/models

append XSCHEM_LIBRARY_PATH :${PDK_ROOT}/${PDK}/libs.tech/xschem
append XSCHEM_LIBRARY_PATH :${PDK_ROOT}/${PDK}/libs.tech/xschem/sg13g2_pr
if {[file exists ${PDK_ROOT}/${PDK}/libs.tech/xschem/sg13g2_pr/cap_cmomi.tcl]} {
    source ${PDK_ROOT}/${PDK}/libs.tech/xschem/sg13g2_pr/cap_cmomi.tcl
}
append XSCHEM_LIBRARY_PATH :${PDK_ROOT}/${PDK}/libs.ref/sg13g2_stdcell/sym/xschem
append XSCHEM_LIBRARY_PATH :$env(XSCHEM_USER_LIBRARY_PATH)
append XSCHEM_LIBRARY_PATH :[file normalize $env(MSDB_ROOT)/../custom_stdcell/xschem]

set netlist_dir $env(PWD)/simulations
set stdcell_view "subcircuit"
set stdcell_sym_type "subcircuit"

# Called from the PDK's sg13g2_stdcell symbols (schematic/type attributes):
# without them the stdcells are not expanded. As in the IHP template rc,
# minus the GUI dialog that switches the view ("subcircuit" here).
proc hierarchy_config {symname} {
    global stdcell_view
    set cell [file rootname [file tail $symname]]
    set sch_dir [file normalize [file join $::PDK_ROOT $::PDK libs.ref sg13g2_stdcell sch xschem]]
    set suffix [expr {$stdcell_view eq "custom" ? "_custom" : ""}]
    set sch [file join $sch_dir "${cell}${suffix}.sch"]
    if {![file exists $sch]} {
        set sch [file join $sch_dir "${cell}.sch"]
    }
    return $sch
}
proc symtype {} {
    global stdcell_sym_type
    return $stdcell_sym_type
}
